# =============================================================
# PDH Bridge Bot - Environment Variables
# =============================================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to GitHub!
# =============================================================

# Your bot's token from the Discord Developer Portal
# Get this at: https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Your bot's Application ID (also called Client ID)
# Found on the "General Information" page of your app
DISCORD_CLIENT_ID=your-client-id-here

# Your personal Discord user ID (right-click yourself > Copy User ID)
# This gives you permission to post in PDH News and use admin commands
OWNER_ID=your-discord-user-id-here

# RSS feed URL for your website (for the PDH News channel)
RSS_FEED_URL=https://your-website.com/feed

# How often to check the RSS feed, in minutes (default: 10)
RSS_POLL_INTERVAL=10

# How long LFG posts last before auto-deletion, in minutes (default: 60)
LFG_EXPIRY_MINUTES=60

# Enable link filtering in Discussion channel? (true/false, default: false)
FILTER_LINKS=false

# Convoke Games API token (for auto-creating game rooms)
# You need written permission from Convoke to use their API.
# Your token starts with "convk_" — paste the full token here.
# The API lives at api.convoke.gg (not convoke.games).
# NEVER share this token publicly or commit it to git!
CONVOKE_TOKEN=your-convoke-token-here
